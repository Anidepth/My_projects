@inherits LayoutComponentBase
@inject AppSettingsService Settings
@implements IDisposable

<div class="app-shell theme-scope @(collapsed ? "app-shell--collapsed" : "")"
     data-mode="@Settings.Mode"
     data-theme="@Settings.ColorTheme"
     data-pure-black="@(Settings.PureBlackDarkMode ? "true" : "false")"
     style="--fs-base:@(Settings.FontSize)px">
    <NavMenu Collapsed="collapsed" OnToggleCollapse="ToggleCollapse" />
    <main class="app-main">
        @Body
    </main>
</div>

@code {
    private bool collapsed;

    protected override async Task OnInitializedAsync()
    {
        await Settings.EnsureLoadedAsync();
        Settings.OnChange += HandleChange;
    }

    private void ToggleCollapse() => collapsed = !collapsed;

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => Settings.OnChange -= HandleChange;
}
